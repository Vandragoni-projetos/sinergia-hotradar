# SINERGIA HOTRADAR — variáveis de ambiente
# Copie para .env (local) ou configure no EasyPanel > Environment (produção).
# ESTE PROJETO É SEPARADO DO ACHADINHOS. Nenhuma variável aqui aponta para o Achadinhos.
#
# REPOSITÓRIO PÚBLICO: este arquivo mostra APENAS os NOMES das variáveis.
# Nenhum valor real de credencial pode ser commitado aqui. Segredos ficam só no
# Environment do EasyPanel.

# ---- Aplicação ----
HR_ENV=local                     # local | production
HR_APP_URL=http://localhost:8090
HR_TIMEZONE=America/Sao_Paulo

# ---- Banco de dados ----
# local  -> sqlite (arquivo em storage/), zero infraestrutura
# production -> mysql (MariaDB próprio do HOTRADAR no EasyPanel; NUNCA o banco do Achadinhos)
HR_DB_DRIVER=sqlite
HR_DB_SQLITE_PATH=storage/hotradar.sqlite

HR_DB_HOST=hotradar_db
HR_DB_PORT=3306
HR_DB_NAME=hotradar
HR_DB_USER=hotradar
HR_DB_PASSWORD=

# ---- Painel (auth básica) ----
HR_PANEL_USER=
HR_PANEL_PASSWORD=

# ---- Coletor Mercado Livre (coletor PÚBLICO — não precisa de API key) ----
HR_ML_ENABLED=1
HR_ML_HTTP_TIMEOUT=30
HR_ML_MAX_PAGES=3                 # fallback do CLI; radares definem o próprio nº de páginas
HR_ML_REQUEST_DELAY_MS=3500       # pausa (com jitter ±40%) entre requisições — educado com o ML
HR_ML_USER_AGENT=
# (opcional/futuro — API oficial ML; NÃO obrigatória para o coletor atual)
ML_API_CLIENT_ID=
ML_API_CLIENT_SECRET=

# ---- Shopee (Open API) — SOMENTE Environment; nunca no banco/Git ----
# Sem estas variáveis a Shopee fica desligada e nenhuma chamada é feita.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---- OpenAI — SOMENTE Environment; usada só para resumos de relatório ----
# A chave nunca é gravada em banco, Git, log ou HTML. Não afeta o HOT SCORE.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Link afiliado ML (fase posterior — não usado em E0/E1/E3/E4) ----
HR_ML_AFFILIATE_MODE=off
HR_ML_AFFILIATE_ENDPOINT=
HR_ML_AFFILIATE_TOKEN=
