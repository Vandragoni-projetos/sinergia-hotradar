# SINERGIA HOTRADAR — variáveis de ambiente
# Copie para .env (local) ou configure no EasyPanel > Environment (produção).
# ESTE PROJETO É SEPARADO DO ACHADINHOS. Nenhuma variável aqui aponta para o Achadinhos.

# ---- Aplicação ----
HR_ENV=local                     # local | production
HR_APP_URL=http://localhost:8090
HR_TIMEZONE=America/Sao_Paulo

# ---- Banco de dados ----
# local  -> sqlite (arquivo em storage/), zero infraestrutura
# production -> mysql (MariaDB próprio do HOTRADAR no EasyPanel; NUNCA o banco do Achadinhos)
HR_DB_DRIVER=sqlite
HR_DB_SQLITE_PATH=storage/hotradar.sqlite

HR_DB_HOST=hotradar-db
HR_DB_PORT=3306
HR_DB_NAME=hotradar
HR_DB_USER=hotradar
HR_DB_PASSWORD=

# ---- Coletor Mercado Livre ----
HR_ML_ENABLED=1
HR_ML_HTTP_TIMEOUT=30
HR_ML_MAX_PAGES=3                 # páginas de /ofertas por categoria e por execução
HR_ML_REQUEST_DELAY_MS=1500       # pausa entre requisições (educado com o ML)
HR_ML_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
# Nichos-alvo da V1 (ids de categoria raiz do ML, separados por vírgula). Vazio = usar preset "casa_cozinha_organizacao".
HR_ML_TARGET_CATEGORIES=

# ---- Coletor Shopee (DESLIGADO — aguardando credenciais Open API) ----
HR_SHOPEE_ENABLED=0
HR_SHOPEE_APP_ID=
HR_SHOPEE_SECRET=
HR_SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# ---- Painel ----
HR_PANEL_USER=admin
HR_PANEL_PASSWORD=hotradar        # troque em produção

# ---- Link afiliado (fase posterior — não usado em E0/E1/E3) ----
# Integração segura com o Link Builder virá depois. NÃO copiar cookie/CSRF do Achadinhos.
HR_ML_AFFILIATE_MODE=off          # off | internal_api (futuro)
HR_ML_AFFILIATE_ENDPOINT=
HR_ML_AFFILIATE_TOKEN=
